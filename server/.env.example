# -----------------------------------------------------------------------------
# localCRM — environment config
# Copy to .env and fill in values.
# -----------------------------------------------------------------------------

# Server
PORT=
NODE_ENV=
CLIENT_ORIGIN=
# Number of trusted reverse-proxy hops in front of this server (Express's
# trust proxy setting) — determines how req.ip and rate-limiter IP keys are
# derived from X-Forwarded-For. Default 1 (Railway's own edge proxy). If a
# CDN/WAF sits in front of that, set this to 2.
TRUST_PROXY_HOPS=1

# Database (MySQL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Encrypts payment_gateway_settings' credential columns at rest (AES-256-GCM).
# Any random string works — generate one the same way as JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required before running scripts/encrypt-gateway-secrets.js or saving gateway
# settings. Losing this key makes existing encrypted credentials unrecoverable
# — back it up the same way you would JWT_SECRET/DB_PASSWORD.
SECRETS_ENCRYPTION_KEY=

# SMTP fallback (DB smtp_settings takes precedence when configured)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Valor Vault live base URL — set once confirmed with Valor PayTech support.
# Sandbox uses https://demo.valorpaytech.com automatically.
# Example: VALOR_VAULT_URL_LIVE=
VALOR_VAULT_URL_LIVE=

# ConnectWise Manage (DB cw_manage_settings takes precedence when configured)
CW_SITE_URL=
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=
CW_API_VERSION=

# AI Assistant (Anthropic Claude)
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=
