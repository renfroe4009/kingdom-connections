# -----------------------------------------------------------------------------
# localCRM — environment config
# Copy to .env and fill in values.
# -----------------------------------------------------------------------------

# Server
PORT=
NODE_ENV=
CLIENT_ORIGIN=

# Database (MySQL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# SMTP fallback (DB smtp_settings takes precedence when configured)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Valor Vault live base URL — set once confirmed with Valor PayTech support.
# Sandbox uses https://demo.valorpaytech.com automatically.
# Example: VALOR_VAULT_URL_LIVE=
VALOR_VAULT_URL_LIVE=

# ConnectWise Manage (DB cw_manage_settings takes precedence when configured)
CW_SITE_URL=
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=
CW_API_VERSION=

# AI Assistant (Anthropic Claude)
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=
