node_modules/
dist/
.env
.env.*
!.env.example
*.log
.DS_Store
.vercel

# VS Code Local History — snapshots every edited file, including server/.env.
# Currently caught incidentally by the .env* rule above (snapshot filenames
# keep the original basename), but that's not a real guarantee: a snapshot of
# any other sensitive file wouldn't match. Ignore the directory outright.
.history/

# Database backups/dumps — client site content, never belongs in git history.
server/backups/

# QA audit output — regenerated by qa/audit.js on every run, and the
# diagnosis agents dump page trees (client site content) alongside it.
qa/reports/

# Local mirror of production media (server/uploads) — derived, redownloadable
# from R2 via sync-local-uploads-to-r2.js's counterpart, not source content.
server/uploads/

# Reference material copied in from another project to guide the donation/
# shop/events wiring pass (modules/WIRING-A-NEW-DESIGN.md etc.) — not part of
# this project's own codebase.
modules/
