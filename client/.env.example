# -----------------------------------------------------------------------------
# kingdom-connections client — environment config
# Copy to .env and adjust ports if 5173/4000 are already in use locally.
# -----------------------------------------------------------------------------

# Port the Vite dev server listens on.
VITE_PORT=5173

# Where the client's dev-server proxy forwards /api requests (the server's PORT).
VITE_API_TARGET=http://localhost:4000

# Leave blank in dev — the client falls back to same-origin /api via the proxy
# above. Set this only for a build that talks to a different API host.
VITE_API_URL=
